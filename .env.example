# Copy to .env for docker compose. Never commit the real .env.
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=hms.voraaddis.com,localhost
CSRF_TRUSTED_ORIGINS=https://hms.voraaddis.com
CORS_ALLOWED_ORIGINS=https://hms.voraaddis.com
# Set to 0 only if you serve plain HTTP on a closed hotel LAN.
SECURE_COOKIES=1
HTTP_PORT=80
# Python path of the fiscal printer driver once the model is known (see backend/apps/billing/fiscal.py).
# FISCAL_DRIVER=apps.billing.drivers.MyPrinterDriver
